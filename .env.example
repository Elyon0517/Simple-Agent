# Supabase (vector database)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI (embeddings required; also used for chat when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# Chat provider: openai | anthropic
AI_PROVIDER=openai

# Optional — only if AI_PROVIDER=anthropic (embeddings still use OpenAI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20240620

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
